# ─────────────────────────────────────────────
#  AI Desktop Agent — Example Configuration
#  Copy this file to .env and fill in values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── AI Provider ──────────────────────────────
# Choose: anthropic | openai | ollama | claude_code
AI_PROVIDER=ollama
# Required when provider is anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Required when provider is openai
OPENAI_API_KEY=sk-REPLACE_ME
# Ollama base URL (default works for local install)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Voice ─────────────────────────────────────
# Choose: faster_whisper | whisper_api | disabled
VOICE_INPUT_PROVIDER=faster_whisper
WHISPER_MODEL_SIZE=base
# Choose: pyttsx3 | elevenlabs | disabled
VOICE_OUTPUT_PROVIDER=pyttsx3
ELEVENLABS_API_KEY=REPLACE_ME_IF_USED

# ── Google Chat Integration ───────────────────
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
# OAuth redirect URI — must match Google console
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/callback
# Comma-separated list of space IDs to monitor
GOOGLE_CHAT_SPACE_IDS=spaces/REPLACE_ME

# ── Upwork Integration ────────────────────────
UPWORK_CLIENT_ID=REPLACE_ME
UPWORK_CLIENT_SECRET=REPLACE_ME
# Minimum budget filter (USD)
UPWORK_MIN_BUDGET=500
UPWORK_MIN_HOURLY_RATE=25

# ── Browser ───────────────────────────────────
# Choose: chromium | chrome | firefox
BROWSER_TYPE=chromium
# Set to a Chrome remote debugging port if connecting to an existing session
CHROME_REMOTE_DEBUG_PORT=

# ── Security ──────────────────────────────────
# Master passphrase for local credential encryption (leave blank to use OS keychain)
CREDENTIAL_PASSPHRASE=

# ── Application ───────────────────────────────
LOG_LEVEL=INFO
# Path where the SQLite database is stored
DB_PATH=data/agent.db
# Maximum number of retry attempts per task step
MAX_STEP_RETRIES=3
# Maximum total task duration in seconds (0 = no limit)
MAX_TASK_DURATION_SECONDS=3600
